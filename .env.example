# =========================================================
# AgentSentry Production & Development Configuration Template
# =========================================================

# ---------------------------------------------------------
# Environment & Server
# ---------------------------------------------------------
API_PORT=8000
HOST=127.0.0.1
# Options: 'development', 'staging', 'production'
# In 'production', strict secret validation and secure cookie policies are enforced.
ENVIRONMENT=development

# ---------------------------------------------------------
# Security & Cryptography
# ---------------------------------------------------------
# Required 32+ character high-entropy key for JWT signing.
# Generate in terminal: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-secret-do-not-use-in-production-change-in-prod-32chars

# CORS Whitelist (comma-separated origins).
# Development: http://localhost:5173,http://127.0.0.1:5173
# Production: https://your-agentsentry-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------
# AI Intelligence Engine (Grok, Gemini, Local)
# ---------------------------------------------------------
# Options: 'auto' (default), 'openai', 'gemini', 'grok', 'local'
# - 'auto': Uses OpenAI if OPENAI_API_KEY is present; otherwise Gemini if GEMINI_API_KEY; otherwise Grok if XAI_API_KEY; otherwise Local fallback.
# - 'openai': Explicitly uses OpenAI API (requires OPENAI_API_KEY).
# - 'gemini': Explicitly uses Google Gemini (requires GEMINI_API_KEY).
# - 'grok': Explicitly uses xAI Grok (requires XAI_API_KEY).
# - 'local': Offline deterministic heuristic engine (0 API costs, works completely offline).
AI_PROVIDER=auto

# Optional override for model names:
# For OpenAI: gpt-4o-mini (default), gpt-4o
# For Gemini: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
# For Grok: grok-beta, grok-2
AI_MODEL=

# OpenAI API Key (optional):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (optional):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# xAI Grok API Key (optional):
XAI_API_KEY=
XAI_MODEL=grok-beta

# ---------------------------------------------------------
# Authentication: Firebase Single Sign-On (Optional)
# ---------------------------------------------------------
# Set your Firebase project ID to enable Google SSO token verification.
# When empty, operators authenticate directly using local credentials.
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------
# Database Storage
# ---------------------------------------------------------
# Development (Default): Lightweight local SQLite via aiosqlite
DATABASE_URL=sqlite+aiosqlite:///dev.db

# Production: Managed PostgreSQL via asyncpg (e.g. Render, Supabase, Neon)
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@ep-sample.render.com/agentsentry

# Local Docker PostgreSQL credentials (if using docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentsentry

# ---------------------------------------------------------
# Frontend Environment
# ---------------------------------------------------------
# Base URL for API requests in production frontend bundle
VITE_API_BASE_URL=http://localhost:8000
