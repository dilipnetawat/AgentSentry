# AgentSentry Environment Configuration Template

# ---------------------------------------------------------
# Backend Configuration
# ---------------------------------------------------------
API_PORT=8000
# Set to 'production' to enforce strict security checks (e.g., secure secret key validation).
ENVIRONMENT=development

# ---------------------------------------------------------
# Security Configuration
# ---------------------------------------------------------
# This MUST be a secure, random string (e.g., 32+ chars) in production.
JWT_SECRET_KEY=dev-secret-do-not-use-in-production

# Cross-Origin Resource Sharing (CORS) Configuration.
# In production, set this strictly to your frontend domain (e.g. https://agentsentry.vercel.app).
# Local development needs both localhost and 127.0.0.1 because browsers treat them as different origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------
# Database (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentsentry

# The Database URL used by the application.
# Local development (no Docker): SQLite
DATABASE_URL=sqlite+aiosqlite:///dev.db
# Local PostgreSQL (optional):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentsentry
# For production Render PostgreSQL, provide the equivalent asyncpg URL.

# ---------------------------------------------------------
# Frontend Configuration
# ---------------------------------------------------------
# Set this to the backend API domain for production Vite builds (e.g. Render).
# Local `npm run dev` uses the Vite proxy to http://127.0.0.1:8000 and does not
# send the browser directly to this URL.
VITE_API_BASE_URL=http://localhost:8000
