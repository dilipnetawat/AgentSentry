{
  "name": "agentsentry",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "python -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "test": "python -m pytest backend/tests/ -v",
    "db:migrate": "python -m alembic upgrade head",
    "db:seed": "python -m scripts.seed"
  }
}
